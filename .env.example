# Copia este archivo a .env.local. No subas credenciales al repositorio.

# Ruta del archivo SQLite con el expediente privado (por defecto: data/legacyarchive.db)
LEGACYARCHIVE_DB_PATH=

# Persistencia remota en Vercel: crea una base libSQL en Turso.
# Configura ambos valores como secretos del servidor, sin prefijo NEXT_PUBLIC_.
# Si están definidos, se usa la base remota también en desarrollo.
# En Vercel son obligatorios: no se usa SQLite local ni /tmp como alternativa.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Croma (opcional). Solo se usa desde el servidor, en /api/croma.
# Crea la clave en https://platform.usecroma.com y pégala aquí localmente.
CROMA_API_KEY=
CROMA_BASE_URL=https://api.croma.run
